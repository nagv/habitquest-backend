    {
      "id": "claim_b1f60bb14a394c0db1d765dececf67df",
      "statement": "PRIMARY_STRENGTH is 0.8. A habit covers a goal strongly when habit.goals[goal] >= PRIMARY_STRENGTH. A habit covers a goal weakly only when every cue-ready alternative for that goal has already been chosen, so no unpicked dedicated option remains.",
      "evidence": [
        {
          "resource": "repo://src/habitquest_backend/catalog/scoring.py#L12-L12",
          "version": "repo-lines-v1:sha256:21c631bfac6f0b84be1696e06be99f338019fc2c0b940a5bc054e8244e9d81b5:"
