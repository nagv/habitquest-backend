  "claims": [
    {
      "id": "claim_0db2f92c2c184557851ec295090afae5",
      "statement": "The catalog domain consists of immutable versioned entities bundled in a Release: Goal (objective with title and description), Concern (pain-point label with synonyms and goal weights), Habit (activity with levels, goals, tags, variants, supports, and withdrawn flag), and Chapter (world-goal narrative title). Habit.presented() selects interest-based wording variants without changing the underlying activity.",
      "evidence": [
        {
          "resource": "repo://src/habitquest_backend/catalog/models.py#L10-L75",
          "version": "repo-lines-v1:sha256:48d1784c4a6f166d52990dd92228cbf0c462278d07b447a7b209c30b287ed9b3:"
        }
      ]
    },
    {
      "id": "claim_521d1a152aef4f12855fdb054fcaa637",
      "statement": "The eligible() hard-filter applies predicates in code order for each habit: withdrawn, serves at least one requested goal, not already active, covers the profile's age band, all topic tags are opted-in, all accessibility needs are met, a level fits within available_minutes, and routine_anchor presence sets needs_cue. Any failing predicate discards the habit.",
      "evidence": [
        {
          "resource": "repo://src/habitquest_backend/catalog/eligibility.py#L16-L45",
          "version": "repo-lines-v1:sha256:1cabea1ddb243a3b508e4a9a292847a6b8be68c8ee02065b9f6d85d268daf4c1:"
        }
      ]
    },
    {
      "id": "claim_ffdcf80690594a62ae97dd44c5f5f8a1",
      "statement": "A Candidate.needs_cue equals True when the habit's routine_anchor is absent from the child's routine_schedule. The habit remains eligible for ranking and shortlists, but cannot be picked by the reviewed template plan or confirmed without adding a cue.",
      "evidence": [
        {
          "resource": "repo://src/habitquest_backend/catalog/eligibility.py#L45-L45",
          "version": "repo-lines-v1:sha256:ca1a403ed9e9cd75c2b3e9c5c6c26236f8a174efcb6728000a2a7306ea25021d:"
        },
        {
