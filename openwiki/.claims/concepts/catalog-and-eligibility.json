    {
      "id": "claim_bdccd90c4c79469fb0fa1e8873914b24",
      "statement": "score() ranks candidates using four deterministic components: goal strength weighted by parent priority order (first goal weight 1.0), INTEREST_BONUS (0.5) for matching interest tags, PREREQ_BONUS (0.3) if the habit supports another eligible habit, and LEVEL_PENALTY subtracted by chosen level (simple 0.0, standard 0.1, stretch 0.3). Ties break by habit.id ascending.",
      "evidence": [
        {
          "resource": "repo://src/habitquest_backend/catalog/scoring.py#L29-L43",
          "version": "repo-lines-v1:sha256:650d5e8d986bdd7b6c689303b3f0cd4106e8c0b828a9d44d84130d37bb6bc545:"
        },
        {
          "resource": "repo://src/habitquest_backend/catalog/scoring.py#L7-L12",
          "version": "repo-lines-v1:sha256:7a6a2e657a67f09baa5c4bd9940ec5fb44ce265deff4af18fffe41abb762919e:"
        }
      ]
    },
    {
      "id": "claim_e5dbcb2e8f9e4641bbbb445b22b56d1d",
      "statement": "RANKING_VERSION is stamped into every proposal document to trace which deterministic scoring formula and template logic produced it; any change to scoring weights, penalties, tie-breaking, or template_plan behaviour must update RANKING_VERSION.",
      "evidence": [
        {
          "resource": "repo://src/habitquest_backend/catalog/scoring.py#L7-L7",
