        {
          "resource": "repo://supabase/migrations/202610280001_onboarding.sql#L3-L6",
          "version": "repo-lines-v1:sha256:42615a8c4bb24237c8dabca259ce5e92f76af9a3bbe016748516a5efdac1aae5:"
