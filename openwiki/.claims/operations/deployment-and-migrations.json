  "claims": [
    {
      "id": "claim_d16e6614fce84bf5a8763bacced30285",
      "statement": "`scripts/bootstrap_local.py` supports two local bootstrap paths: Supabase (default), which starts Docker-based Supabase and extracts the database URL from `supabase status`, and native PostgreSQL (`--native`), which runs `initdb` under `.local/postgres` at default port 55433 with SCRAM-SHA-256 authentication. It preserves existing `.env` files and writes one only if absent.",
      "evidence": [
        {
          "resource": "repo://scripts/bootstrap_local.py",
          "version": "repo-file-v1:sha256:fe5a1e1bddc9bb9a8d51a19b79112bd20de1197aa71786ce16ccc95c04569125"
        }
      ]
    },
    {
      "id": "claim_c3061df53ce64ea9bfdf8371e3f3c861",
      "statement": "`scripts/setup_db.py` takes an advisory transaction lock (`pg_advisory_xact_lock(28102026)`), iterates `supabase/migrations/*.sql` in filename order, computes a SHA-256 digest per file, raises `RuntimeError` if a previously recorded digest differs, skips execution if Supabase CLI already applied the migration, and records each digest in `public.hq_migrations`.",
      "evidence": [
        {
          "resource": "repo://scripts/setup_db.py#L13-L38",
          "version": "repo-lines-v1:sha256:d912ee31300225dde63dad6d6dc57c1425a98747ef45b0c6f85cc36aef4d0137:"
        }
      ]
    },
    {
      "id": "claim_1fcf9b265a8f496d98573ccb799dfd91",
      "statement": "The migration system is forward-only: there is no rollback or down-migration path, and `setup_db.py` never resets an existing database.",
      "evidence": [
        {
          "resource": "repo://scripts/setup_db.py",
          "version": "repo-file-v1:sha256:fabe4e1185d9cc7afbc493012499cd3661e4e60336b6939f3ccd6575a87bf291"
        }
      ]
    },
    {
      "id": "claim_9eafc184822443e2bd0ce59faebc983a",
      "statement": "Migrations create `hq_api`, `hq_worker`, and `hq_editor` as `NOLOGIN` roles, so the database login applying them needs `CREATEROLE`.",
