        }
      ]
    },
    {
      "id": "claim_987cf93907e141cfa569f318da785b26",
      "statement": "After applying migrations, `scripts/setup_db.py` runs `GRANT hq_api, hq_worker, hq_editor TO CURRENT_USER` so the connecting login can switch into those roles via `SET LOCAL ROLE`.",
