    {
      "id": "claim_8cf6f6b27df24e999e2b4ea4e128ad49",
      "statement": "HabitQuest runs as three co-operating systems that share only one PostgreSQL database: the FastAPI request process, the durable planning worker, and the schema holding household state, catalog releases and LangGraph checkpoints; the API and the worker never call each other and hq.jobs is the only channel between them.",
      "evidence": [
        {
          "resource": "repo://README.md#L7-L11",
          "version": "repo-lines-v1:sha256:56e5b98690b2239460660d5273c67ef0e03b71e3f4ca19bb9e718dfb865e6b28:"
        },
