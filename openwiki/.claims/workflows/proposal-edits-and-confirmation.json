    {
      "id": "claim_d686c6f964b1454291a468b16b8b90a2",
      "statement": "apply_patch() re-runs five publication rules after every edit: max_active_habits, available_minutes, needs_cue, coverage and chapter availability. A violation raises ValueError, which the patch_proposal handler translates to HTTP 422 with the rule name as the message prefix.",
      "evidence": [
        {
          "resource": "repo://src/habitquest_backend/main.py#L268-L311",
          "version": "repo-lines-v1:sha256:3ca6638329db55da41ab504005acdc8b07d72871b6e234dcbc2d46a1cd0ad451:"
