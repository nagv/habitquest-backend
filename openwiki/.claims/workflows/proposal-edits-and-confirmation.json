    {
      "id": "claim_ef91d98ff2824b0b99226e8c7b5924eb",
      "statement": "confirm() acquires locks in strict order: a row-level FOR UPDATE on the proposal; a pg_advisory_xact_lock on the child; a FOR UPDATE on the intake followed by hq.lock_intake(); and finally catalog/policy/habit SHARE locks via validate_sources() calling hq.lock_release(). This prevents deadlocks and interleaving with concurrent profile edits, intake changes, catalog withdrawals or policy updates.",
      "evidence": [
        {
          "resource": "repo://src/habitquest_backend/service.py#L47-L60",
          "version": "repo-lines-v1:sha256:627e62b76b6f2e1f430a2123f1641dabbf900b84e817f84b773e8564f385c0a2:"
        },
