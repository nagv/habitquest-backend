    {
      "id": "claim_0c83cb0b1aa6424ea2fce78644d612ac",
      "statement": "The strict coverage rule requires that a weak habit-goal link (below PRIMARY_STRENGTH = 0.8) only counts as covering a goal when no cue-ready alternative for that goal remains inactive in either the shortlist or the future list. This prevents demoting a habit from silently leaving a goal uncovered when a dedicated alternative still exists.",
      "evidence": [
        {
          "resource": "repo://src/habitquest_backend/catalog/scoring.py#L12-L12",
          "version": "repo-lines-v1:sha256:21c631bfac6f0b84be1696e06be99f338019fc2c0b940a5bc054e8244e9d81b5:"
